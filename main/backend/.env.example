# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp

# Firebase Configuration (from serviceAccountKey.json)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id

# Frontend Firebase Configuration (for client-side)
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Chat JWT Configuration (separate from app JWT, used by Socket.io)
CHAT_JWT_SECRET_CURRENT=chat-secret-change-this-in-production
CHAT_JWT_SECRET_PREVIOUS=
CHAT_JWT_ROTATION_TS=0

# Redis (for presence, typing indicators, call sessions)
REDIS_URL=redis://localhost:6379

# Media Storage (S3 / MinIO)
S3_BUCKET=yappers-media
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ClamAV malware scanner (optional for development)
CLAMAV_HOST=localhost
